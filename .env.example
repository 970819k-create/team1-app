# 선택 사항: 서버 공용 키
# 보통은 각자 앱의 [설정] 화면에서 키를 넣어요(각자의 브라우저에만 저장).
# 서버를 켠 사람이 여기 키를 넣어 두면, 키를 넣지 않은 사람도 이 키로 AI를 쓸 수 있어요.
# 쓰려면 이 파일을 .env로 복사해 필요한 줄만 채우세요. (.env는 GitHub에 올라가지 않아요)
# AI_PROVIDER=claude   # claude | openai | gemini | huggingface | ollama
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_MODEL=gemini-2.5-flash
# HF_MODEL=openai/gpt-oss-120b
# OLLAMA_MODEL=qwen2.5:7b
# PORT=3000
